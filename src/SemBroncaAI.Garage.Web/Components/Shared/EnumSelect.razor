@typeparam T where T:struct,Enum
<MudSelect T="T" Value="Value" ValueChanged="ValueChanged" Label="@Label">@foreach(var value in Enum.GetValues<T>()){<MudSelectItem T="T" Value="value">@Display(value)</MudSelectItem>}</MudSelect>
@code{[Parameter]public string Label{get;set;}="";[Parameter]public T Value{get;set;}[Parameter]public EventCallback<T> ValueChanged{get;set;}private static string Display(T value)=>value.ToString() switch{"Lead"=>"Lead","AwaitingMaterials"=>"Aguardando materiais","Planning"=>"Planejamento","InDevelopment"=>"Em desenvolvimento","AwaitingApproval"=>"Aguardando aprovação","Adjustments"=>"Ajustes","ReadyToPublish"=>"Pronto para publicar","Published"=>"Publicado","Paused"=>"Pausado","Cancelled"=>"Cancelado","Current"=>"Em dia","Pending"=>"Pendente","Overdue"=>"Em atraso","Suspended"=>"Suspenso","Draft"=>"Rascunho","AwaitingSignature"=>"Aguardando assinatura","Active"=>"Ativo","Closed"=>"Encerrado","Inactive"=>"Inativo","OneTime"=>"Única","Monthly"=>"Mensal","Quarterly"=>"Trimestral","Semiannual"=>"Semestral","Annual"=>"Anual","Mailbox"=>"Caixa postal","Alias"=>"Alias","Group"=>"Grupo",_=>value.ToString()};}
