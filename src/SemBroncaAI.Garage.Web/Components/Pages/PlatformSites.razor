@page "/platform-admin/sites"
@layout PlatformAdminLayout
@attribute [Authorize(Policy=PlatformAuthorization.Policy)]
@using SemBroncaAI.Garage.Application.Abstractions.Security
@using SemBroncaAI.Garage.Application.Features.SiteManagement
@using SemBroncaAI.Garage.Domain.Entities.SiteManagement
@inject PlatformSiteService Service
@inject ISnackbar Snackbar
<PageTitle>Gerenciador de Sites | SemBroncaAI</PageTitle>
<div class="sites-page">
 <div class="page-head"><div><span class="eyebrow">OPERAÇÃO DIGITAL</span><h1>Gerenciador de Sites</h1><p>Clientes, projetos, infraestrutura, recorrência e renovações em um só lugar.</p></div><a class="primary" href="/platform-admin/sites/new"><MudIcon Icon="@Icons.Material.Filled.Add" />Novo Site</a></div>
 @if(_loading){<div class="state"><MudProgressCircular Indeterminate="true"/><strong>Carregando operação</strong></div>}
 else if(_data is not null){
 <div class="summary-grid"><article><small>Sites ativos</small><strong>@_data.ActiveSites</strong></article><article><small>Em desenvolvimento</small><strong>@_data.InDevelopment</strong></article><article><small>MRR</small><strong>@Money(_data.Mrr)</strong></article><article><small>Custos mensais</small><strong>@Money(_data.RecurringCosts)</strong></article><article><small>Margem estimada</small><strong>@Money(_data.EstimatedMargin)</strong></article><article><small>Pendências</small><strong>@_data.PendingItems</strong></article><article><small>Renovações (30 dias)</small><strong>@_data.UpcomingRenewals</strong></article></div>
 <section class="filters-card">
  <header><div><h2>Filtros</h2><p>Encontre rapidamente um cliente, domínio ou situação operacional.</p></div></header>
  <div class="filters"><MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_search" Label="Cliente ou domínio" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"/><MudSelect Variant="Variant.Outlined" Margin="Margin.Dense" T="ManagedSiteStatus?" @bind-Value="_status" Label="Status" Clearable="true">@foreach(var value in Enum.GetValues<ManagedSiteStatus>()){<MudSelectItem T="ManagedSiteStatus?" Value="value">@Status(value)</MudSelectItem>}</MudSelect><MudSelect Variant="Variant.Outlined" Margin="Margin.Dense" T="ManagedSiteFinancialStatus?" @bind-Value="_financial" Label="Financeiro" Clearable="true">@foreach(var value in Enum.GetValues<ManagedSiteFinancialStatus>()){<MudSelectItem T="ManagedSiteFinancialStatus?" Value="value">@Financial(value)</MudSelectItem>}</MudSelect><MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_hosting" Label="Hospedagem"/><MudSelect Variant="Variant.Outlined" Margin="Margin.Dense" T="bool?" @bind-Value="_active" Label="Situação" Clearable="true"><MudSelectItem T="bool?" Value="true">Ativos</MudSelectItem><MudSelectItem T="bool?" Value="false">Arquivados</MudSelectItem></MudSelect><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadAsync">Filtrar</MudButton></div>
 </section>
 <section class="list-card"><header><div><h2>Sites / Clientes</h2><p>@_data.Items.Count registro(s)</p></div></header>
  <div class="table-scroll"><table><thead><tr><th>Cliente</th><th>Domínio</th><th>Status</th><th>Hospedagem</th><th>Plano mensal</th><th>Custo mensal</th><th>Próximo vencimento</th><th>Financeiro</th><th>Ações</th></tr></thead><tbody>@if(_data.Items.Count==0){<tr><td colspan="9"><div class="empty"><MudIcon Icon="@Icons.Material.Filled.Language"/><strong>Nenhum site encontrado</strong><span>Cadastre o primeiro cliente ou ajuste os filtros.</span><a href="/platform-admin/sites/new">Cadastrar primeiro site</a></div></td></tr>}else{@foreach(var item in _data.Items){<tr><td><strong>@item.TradeName</strong></td><td>@item.Domain</td><td><span class="badge">@Status(item.Status)</span></td><td>@(item.HostingProvider??"—")</td><td>@Money(item.MonthlyFee)</td><td>@Money(item.RecurringCost)</td><td>@(item.NextDue?.ToString("dd/MM/yyyy")??"—")</td><td>@Financial(item.FinancialStatus)</td><td><div class="actions"><a href="@($"/platform-admin/sites/{item.Id}")">Visualizar / editar</a><button @onclick="()=>Toggle(item)">@(item.Active?"Arquivar":"Reativar")</button></div></td></tr>}}</tbody></table></div>
  @if(_data.Items.Count>0){<div class="mobile-list">@foreach(var item in _data.Items){<article><header><div><strong>@item.TradeName</strong><small>@item.Domain</small></div><span class="badge">@Status(item.Status)</span></header><dl><div><dt>Hospedagem</dt><dd>@(item.HostingProvider??"—")</dd></div><div><dt>Mensalidade</dt><dd>@Money(item.MonthlyFee)</dd></div><div><dt>Custo</dt><dd>@Money(item.RecurringCost)</dd></div><div><dt>Financeiro</dt><dd>@Financial(item.FinancialStatus)</dd></div></dl><div class="actions"><a href="@($"/platform-admin/sites/{item.Id}")">Abrir</a><button @onclick="()=>Toggle(item)">@(item.Active?"Arquivar":"Reativar")</button></div></article>}</div>}
 </section>}
</div>
@code{private ManagedSiteDashboard? _data;private bool _loading=true;private string? _search,_hosting;private ManagedSiteStatus? _status;private ManagedSiteFinancialStatus? _financial;private bool? _active=true;protected override Task OnInitializedAsync()=>LoadAsync();private async Task LoadAsync(){_loading=true;try{_data=await Service.DashboardAsync(_search,_status,_financial,_hosting,_active);}catch{Snackbar.Add("Não foi possível carregar os sites.",Severity.Error);}finally{_loading=false;}}private async Task Toggle(ManagedSiteListItem item){await Service.SetActiveAsync(item.Id,!item.Active);Snackbar.Add(item.Active?"Site arquivado.":"Site reativado.",Severity.Success);await LoadAsync();}private static string Money(decimal v)=>v.ToString("C",new System.Globalization.CultureInfo("pt-BR"));private static string Status(ManagedSiteStatus v)=>v switch{ManagedSiteStatus.AwaitingMaterials=>"Aguardando materiais",ManagedSiteStatus.Planning=>"Em planejamento",ManagedSiteStatus.InDevelopment=>"Em desenvolvimento",ManagedSiteStatus.AwaitingApproval=>"Aguardando aprovação",ManagedSiteStatus.ReadyToPublish=>"Pronto para publicação",_=>v.ToString()};private static string Financial(ManagedSiteFinancialStatus v)=>v switch{ManagedSiteFinancialStatus.Current=>"Em dia",ManagedSiteFinancialStatus.Overdue=>"Atrasado",ManagedSiteFinancialStatus.Suspended=>"Suspenso",_=>"Pendente"};}
