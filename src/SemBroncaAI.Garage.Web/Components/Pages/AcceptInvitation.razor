@page "/accept-invitation"
@layout AuthLayout
@using SemBroncaAI.Garage.Application.Features.TeamManagement
@inject TeamInvitationService Service
<PageTitle>Aceitar convite | SBGarage</PageTitle>
<main><h1>Defina sua senha</h1><p>Conclua seu acesso à equipe da oficina.</p>@if(_activated){<div class="message">Acesso ativado. Você já pode entrar.</div><a class="login-cta" href="/login">Ir para o login</a>}else{<form @onsubmit="Accept" @onsubmit:preventDefault><label>Senha<input type="@(_showPassword?"text":"password")" @bind="_password" /></label><label>Confirmar senha<input type="@(_showPassword?"text":"password")" @bind="_confirmation" /></label><label class="show-password"><input type="checkbox" @bind="_showPassword" /> Mostrar senha</label><small>Mínimo de 10 caracteres, com maiúscula, minúscula, número e quatro caracteres distintos.</small>@if(_message is not null){<div class="message">@_message</div>}<button type="submit" disabled="@_saving">@(_saving?"Salvando...":"Ativar acesso")</button></form>}</main>
@code{[SupplyParameterFromQuery]public Guid Id{get;set;}[SupplyParameterFromQuery]public string? Token{get;set;}private string _password="",_confirmation="";private bool _saving,_showPassword,_activated;private string? _message;private async Task Accept(){if(_saving)return;_saving=true;try{var r=await Service.AcceptAsync(new(Id,Token??"",_password,_confirmation));_activated=r.Succeeded;_message=r.Succeeded?null:r.Code switch{"expired"=>"Este convite expirou.","used"=>"Este convite já foi utilizado.","mismatch"=>"As senhas não coincidem.","password"=>r.Errors?.SelectMany(x=>x.Value).FirstOrDefault()??"A senha não atende aos requisitos.",_=>"Este convite é inválido."};}finally{_saving=false;}}}
