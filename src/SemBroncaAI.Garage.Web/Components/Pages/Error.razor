@page "/Error"
@using System.Diagnostics

<PageTitle>Não foi possível concluir | SBGarage</PageTitle>

<main class="error-page">
    <section class="error-card">
        <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Primary" Size="Size.Large" />
        <h1>Não foi possível concluir esta ação.</h1>
        <p>Tente novamente em alguns instantes. Se o problema continuar, informe o código abaixo ao suporte.</p>
        @if (ShowRequestId)
        {
            <p class="reference">Código de atendimento: <code>@RequestId</code></p>
        }
        <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary">Voltar ao início</MudButton>
    </section>
</main>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
