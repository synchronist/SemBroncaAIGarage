@page "/service-orders/{Id:guid}/estimate/print"
@layout PrintLayout
@attribute [Authorize(Policy = ApplicationPermissions.ViewEstimateValues)]
@using SemBroncaAI.Garage.Application.Abstractions.Security
@using SemBroncaAI.Garage.Web.Models
@using SemBroncaAI.Garage.Web.Services
@using SemBroncaAI.Garage.Web.Components.Documents
@inject ServiceOrderService ServiceOrderService
@inject GarageService GarageService
@inject IConfiguration Configuration
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Impressão do orçamento</PageTitle>
<style>.estimate-document .accepted-total strong{color:var(--brand-color)}</style>

@if (_loading)
{
    <div class="document-state">Carregando orçamento...</div>
}
else if (_document is null)
{
    <div class="document-state">Orçamento não disponível para esta ordem de serviço.</div>
}
else
{
    <div class="document-actions no-print"><button @onclick="GoBack">Voltar</button><button class="primary" @onclick="PrintAsync">Imprimir</button></div>
    <article class="estimate-document" style="--brand-color: @_document.Garage.PrimaryColor">
        <DocumentBrandHeader Garage="_document.Garage" Title="ORÇAMENTO" Number="@($"OS #{_document.ServiceOrderNumber:D4}")" />

        <section class="identification avoid-break">
            <div><small>Data</small><strong>@_document.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</strong></div>
            <div><small>Cliente</small><strong>@_document.Customer.Name</strong><span>@_document.Customer.Document · @_document.Customer.Phone</span></div>
            <div><small>Veículo</small><strong>@_document.Vehicle.Brand @_document.Vehicle.Model</strong><span>@_document.Vehicle.Plate · @_document.Vehicle.Version · @_document.Vehicle.Year</span></div>
            <div><small>Quilometragem na entrada</small><strong>@(_document.Mileage.HasValue ? $"{_document.Mileage:N0} km" : "Não registrada")</strong></div>
        </section>

        <section class="text-section avoid-break"><h2>Relato do cliente</h2><p>@_document.CustomerComplaint</p></section>
        @if (_document.Diagnosis is not null)
        {
            <section class="text-section avoid-break"><h2>Diagnóstico técnico</h2><p>@_document.Diagnosis.Description</p></section>
        }

        <section class="budget-section"><h2>Itens do orçamento</h2>
            <table><thead><tr><th>Tipo</th><th>Descrição</th><th class="number">Qtd.</th><th class="number">Unitário</th><th class="number">Total</th></tr></thead>
                <tbody>@foreach(var item in _document.Estimate.Items){<tr><td>@TypeLabel(item.Type)</td><td>@item.Description @if (ItemDecision(item.AuthorizationStatus) is { } decision) { <small>— @decision</small> }</td><td class="number">@item.Quantity.ToString("N2")</td><td class="number">@Currency(item.UnitPrice)</td><td class="number">@Currency(item.Total)</td></tr>}</tbody>
            </table>
            <div class="totals"><span>Subtotal serviços <strong>@Currency(_document.Estimate.ServicesSubtotal)</strong></span><span>Subtotal peças <strong>@Currency(_document.Estimate.PartsSubtotal)</strong></span><span class="grand-total">Total do orçamento <strong>@Currency(_document.Estimate.Total)</strong></span>@if (_document.Approval?.Status is "Approved" or "PartiallyApproved") { <span class="grand-total">Total autorizado <strong>@Currency(_document.Approval.ApprovedTotal ?? _document.Estimate.Total)</strong></span> }</div>
        </section>

        <section class="acceptance avoid-break"><h2>Aceite do orçamento</h2>
            @if (_document.Approval?.Status is "Approved" or "PartiallyApproved")
            {
                <div class="accepted-total">@(_document.Approval.Status == "PartiallyApproved" ? "Aprovado parcialmente" : "Aprovado integralmente") — <strong>@Currency(_document.Approval.ApprovedTotal ?? _document.Estimate.Total)</strong></div>
                <p>Declarado por @_document.Approval.CustomerName @(_document.Approval.CustomerDocumentMasked is null ? null : $"({_document.Approval.CustomerDocumentMasked})") em @_document.Approval.RespondedAt?.ToLocalTime().ToString("dd/MM/yyyy 'às' HH:mm").</p>
                @if (!string.IsNullOrWhiteSpace(_document.Approval.CustomerComment)) { <p><strong>Observação:</strong> @_document.Approval.CustomerComment</p> }
            }
            else
            {
                <div class="accepted-total">Valor total: <strong>@Currency(_document.Estimate.Total)</strong></div>
                <div class="choices"><span>☐ Aprovo o orçamento</span><span>☐ Não aprovo o orçamento</span></div>
                <div class="signature"><span></span><strong>Cliente</strong></div><div class="date">Data: ____/____/________</div>
            }
        </section>
        <div class="document-footer">Orçamento emitido pelo SemBroncaAI Garage</div>
    </article>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private ServiceOrderEstimatePrintModel? _document; private bool _loading = true;
    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try
        {
            var order = await ServiceOrderService.GetByIdAsync(Id);
            if (order is null) return;
            var garage = await GarageService.GetContextAsync();
            if (garage is null) return;
            _document = ServiceOrderEstimatePrintBuilder.Build(order, garage, GarageService.GetLogoUrl(garage.LogoStorageKey));
        }
        finally { _loading = false; }
    }
    private async Task PrintAsync() => await JS.InvokeVoidAsync("print");
    private void GoBack() => Navigation.NavigateTo($"/service-orders/{Id}");
    private static string Currency(decimal value) => value.ToString("C2", new System.Globalization.CultureInfo("pt-BR"));
    private static string TypeLabel(string type) => type == "Service" ? "Serviço" : type == "Part" ? "Peça" : type;
    private static string? ItemDecision(string authorizationStatus) => authorizationStatus switch
    {
        "CustomerAuthorized" => "Autorizado pelo cliente",
        "CustomerNotAuthorized" => "Não autorizado pelo cliente",
        "DigitalApprovalWaived" => "Aceite digital dispensado pela oficina",
        _ => null
    };
}
