@page "/service-orders/{Id:guid}/estimate/print"
@layout PrintLayout
@using SemBroncaAI.Garage.Web.Models
@using SemBroncaAI.Garage.Web.Services
@inject ServiceOrderService ServiceOrderService
@inject GarageService GarageService
@inject IConfiguration Configuration
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Impressão do orçamento</PageTitle>
<style>.garage-logo{width:44px;height:44px;object-fit:contain}.estimate-document .document-header{border-bottom-color:var(--brand-color)}.estimate-document .document-heading strong,.estimate-document .accepted-total strong{color:var(--brand-color)}</style>

@if (_loading)
{
    <div class="document-state">Carregando orçamento...</div>
}
else if (_document is null)
{
    <div class="document-state">Orçamento não disponível para esta ordem de serviço.</div>
}
else
{
    <div class="document-actions no-print"><button @onclick="GoBack">Voltar</button><button class="primary" @onclick="PrintAsync">Imprimir</button></div>
    <article class="estimate-document" style="--brand-color: @_document.Garage.PrimaryColor">
        <header class="document-header">
            @if (_document.Garage.LogoUrl is not null) { <img class="garage-logo" src="@_document.Garage.LogoUrl" alt="Logo da oficina" /> }
            <div class="garage-heading"><h1>@_document.Garage.Name</h1><p>@_document.Garage.Document</p>
                @if (!string.IsNullOrWhiteSpace(Address)){<p>@Address</p>}<p>@_document.Garage.Phone · @_document.Garage.Email</p></div>
            <div class="document-heading"><span>ORÇAMENTO</span><strong>OS #@_document.ServiceOrderNumber.ToString("D4")</strong></div>
        </header>

        <section class="identification avoid-break">
            <div><small>Data</small><strong>@_document.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</strong></div>
            <div><small>Cliente</small><strong>@_document.Customer.Name</strong><span>@_document.Customer.Document · @_document.Customer.Phone</span></div>
            <div><small>Veículo</small><strong>@_document.Vehicle.Brand @_document.Vehicle.Model</strong><span>@_document.Vehicle.Plate · @_document.Vehicle.Version · @_document.Vehicle.Year</span></div>
            <div><small>Quilometragem na entrada</small><strong>@(_document.Mileage.HasValue ? $"{_document.Mileage:N0} km" : "Não registrada")</strong></div>
        </section>

        <section class="text-section avoid-break"><h2>Relato do cliente</h2><p>@_document.CustomerComplaint</p></section>
        @if (_document.Diagnosis is not null)
        {
            <section class="text-section avoid-break"><h2>Diagnóstico técnico</h2><p>@_document.Diagnosis.Description</p></section>
        }

        <section class="budget-section"><h2>Itens do orçamento</h2>
            <table><thead><tr><th>Tipo</th><th>Descrição</th><th class="number">Qtd.</th><th class="number">Unitário</th><th class="number">Total</th></tr></thead>
                <tbody>@foreach(var item in _document.Estimate.Items){<tr><td>@TypeLabel(item.Type)</td><td>@item.Description</td><td class="number">@item.Quantity.ToString("N2")</td><td class="number">@Currency(item.UnitPrice)</td><td class="number">@Currency(item.Total)</td></tr>}</tbody>
            </table>
            <div class="totals"><span>Subtotal serviços <strong>@Currency(_document.Estimate.ServicesSubtotal)</strong></span><span>Subtotal peças <strong>@Currency(_document.Estimate.PartsSubtotal)</strong></span><span class="grand-total">Total geral <strong>@Currency(_document.Estimate.Total)</strong></span></div>
        </section>

        <section class="acceptance avoid-break"><h2>Aceite do orçamento</h2><div class="accepted-total">Valor total: <strong>@Currency(_document.Estimate.Total)</strong></div>
            <div class="choices"><span>☐ Aprovo o orçamento</span><span>☐ Não aprovo o orçamento</span></div>
            <div class="signature"><span></span><strong>Cliente</strong></div><div class="date">Data: ____/____/________</div>
        </section>
        <div class="document-footer">Orçamento emitido pelo SBGarage</div>
    </article>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private ServiceOrderEstimatePrintModel? _document; private bool _loading = true;
    private string Address => _document is null ? string.Empty : FormatAddress(_document.Garage);
    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try
        {
            if (!Guid.TryParse(Configuration["Garage:Id"], out var garageId)) return;
            var order = await ServiceOrderService.GetByIdAsync(Id);
            if (order is null || order.GarageId != garageId) return;
            var garage = await GarageService.GetAsync(garageId);
            if (garage is null) return;
            _document = ServiceOrderEstimatePrintBuilder.Build(order, garage, GarageService.GetLogoUrl(garageId, garage.LogoStorageKey));
        }
        finally { _loading = false; }
    }
    private async Task PrintAsync() => await JS.InvokeVoidAsync("print");
    private void GoBack() => Navigation.NavigateTo($"/service-orders/{Id}");
    private static string Currency(decimal value) => value.ToString("C2", new System.Globalization.CultureInfo("pt-BR"));
    private static string TypeLabel(string type) => type == "Service" ? "Serviço" : type == "Part" ? "Peça" : type;
    private static string FormatAddress(GaragePrintModel garage)
    {
        var street = string.Join(", ", new[] { garage.Street, garage.Number }.Where(value => !string.IsNullOrWhiteSpace(value)));
        var district = string.Join(" - ", new[] { garage.Neighborhood, garage.Complement }.Where(value => !string.IsNullOrWhiteSpace(value)));
        var city = string.IsNullOrWhiteSpace(garage.City) ? null : string.IsNullOrWhiteSpace(garage.State) ? garage.City : $"{garage.City}/{garage.State}";
        return string.Join(" · ", new[] { street, district, city, garage.PostalCode }.Where(value => !string.IsNullOrWhiteSpace(value)));
    }
}
