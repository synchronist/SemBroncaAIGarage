@page "/customers"
@attribute [Authorize(Policy = ApplicationPermissions.ViewCustomersVehicles)]
@using SemBroncaAI.Garage.Application.Abstractions.Security
@using SemBroncaAI.Garage.Web.Components.Customers
@using SemBroncaAI.Garage.Web.Models
@using SemBroncaAI.Garage.Web.Services
@inject CustomerService CustomerService
@inject IConfiguration Configuration
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Clientes</PageTitle>

<div class="customers-page">
    <header class="customers-header">
        <div><h1>Clientes</h1><p>Consulte os clientes e veículos vinculados à oficina.</p></div>
        <AuthorizeView Policy="@ApplicationPermissions.ManageCustomersVehicles">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="OpenCreateDialogAsync">Novo cliente</MudButton>
        </AuthorizeView>
    </header>

    <section class="customers-toolbar">
        <MudTextField T="string" Value="_search" ValueChanged="OnSearchChanged" Immediate="true"
                      Placeholder="Buscar por nome, documento, telefone ou e-mail..." Variant="Variant.Outlined"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
    </section>

    @if (_isLoading)
    {
        <div class="customers-state"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /><span>Carregando clientes...</span></div>
    }
    else if (_data is null || _data.Items.Count == 0)
    {
        <div class="customers-state"><MudIcon Icon="@Icons.Material.Filled.PeopleOutline" Size="Size.Large" /><h2>Nenhum cliente encontrado</h2><p>Ajuste sua busca ou consulte a equipe administrativa.</p></div>
    }
    else
    {
        <div class="customers-summary"><strong>@_data.TotalItems</strong> @(_data.TotalItems == 1 ? "cliente encontrado" : "clientes encontrados")</div>
        <div class="customers-list">
            @foreach (var customer in _data.Items)
            {
                <article class="customer-card">
                    <div class="customer-avatar">@GetInitials(customer.Name)</div>
                    <div class="customer-main"><strong>@customer.Name</strong><span>@FormatPhone(customer.Phone)</span></div>
                    <div class="customer-field"><small>Documento</small><span>@customer.Document</span></div>
                    <div class="customer-field"><small>E-mail</small><span>@customer.Email</span></div>
                    <div class="vehicle-count"><MudIcon Icon="@Icons.Material.Filled.DirectionsCar" Size="Size.Small" />@customer.VehicleCount</div>
                    <MudButton Variant="Variant.Outlined" OnClick="@(() => Open(customer.Id))">Abrir</MudButton>
                </article>
            }
        </div>

        @if (_data.TotalPages > 1)
        {
            <div class="customers-pagination">
                <MudButton Variant="Variant.Outlined" Disabled="@(_page == 1)" OnClick="PreviousPageAsync">Anterior</MudButton>
                <span>Página @_page de @_data.TotalPages</span>
                <MudButton Variant="Variant.Outlined" Disabled="@(_page >= _data.TotalPages)" OnClick="NextPageAsync">Próxima</MudButton>
            </div>
        }
    }
</div>

@code {
    private CustomerListModel? _data;
    private CancellationTokenSource? _searchCancellation;
    private string _search = string.Empty;
    private int _page = 1;
    private const int PageSize = 12;
    private bool _isLoading;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try { _isLoading = true; _data = await CustomerService.ListAsync(_search, _page, PageSize); }
        catch (Exception exception) { Snackbar.Add(exception.Message, Severity.Error); }
        finally { _isLoading = false; }
    }

    private async Task OnSearchChanged(string value)
    {
        _search = value;
        _searchCancellation?.Cancel();
        _searchCancellation?.Dispose();
        _searchCancellation = new CancellationTokenSource();
        try { await Task.Delay(300, _searchCancellation.Token); _page = 1; await LoadAsync(); }
        catch (OperationCanceledException) { }
    }

    private async Task OpenCreateDialogAsync()
    {
        var parameters = new DialogParameters();
        var dialog = await DialogService.ShowAsync<CustomerFormDialog>("Novo cliente", parameters, new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false }) { Snackbar.Add("Cliente cadastrado com sucesso.", Severity.Success); await LoadAsync(); }
    }

    private void Open(Guid id) => Navigation.NavigateTo($"/customers/{id}");
    private async Task PreviousPageAsync() { _page--; await LoadAsync(); }
    private async Task NextPageAsync() { _page++; await LoadAsync(); }
    private static string GetInitials(string name) => string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpperInvariant(x[0])));
    private static string FormatPhone(string phone) => phone.Length == 11 ? $"({phone[..2]}) {phone.Substring(2, 5)}-{phone.Substring(7, 4)}" : phone;
}
