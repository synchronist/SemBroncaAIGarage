@page "/platform-admin/garages/{Id:guid}"
@layout PlatformAdminLayout
@attribute [Authorize(Policy = PlatformAuthorization.Policy)]
@using SemBroncaAI.Garage.Application.Abstractions.Security
@using SemBroncaAI.Garage.Application.Features.PlatformAdministration
@using SemBroncaAI.Garage.Domain.Entities.Garage
@using SemBroncaAI.Garage.Domain.Entities
@inject PlatformGarageService Service

<PageTitle>Detalhes da oficina | SemBroncaAI</PageTitle>
<a class="back" href="/platform-admin/garages"><MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />Voltar para oficinas</a>
@if (_loading) { <div class="state"><MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" /><strong>Carregando oficina</strong><span>Buscando informações administrativas.</span></div> }
else if (_error is not null) { <div class="state"><span class="state-icon"><MudIcon Icon="@Icons.Material.Filled.CloudOff" /></span><strong>Não foi possível carregar a oficina</strong><span>@_error</span></div> }
else if (_garage is null) { <div class="state"><span class="state-icon"><MudIcon Icon="@Icons.Material.Filled.Storefront" /></span><strong>Oficina não encontrada</strong><span>O cadastro solicitado não está disponível.</span></div> }
else {
    <div class="page-head"><div><span class="eyebrow">DETALHES DA OFICINA</span><div class="title-line"><span class="garage-mark">@GetInitial(_garage.Name)</span><h1>@_garage.Name</h1><span class="badge @(_garage.Active ? "active" : "inactive")">@(_garage.Active ? "Ativa" : "Inativa")</span></div><p>Cadastrada em @_garage.CreatedAt.ToString("dd 'de' MMMM 'de' yyyy")</p></div></div>
    @if (Created) { <div class="success">Oficina criada. Convite de ativação do proprietário gerado.</div> }
    @if (_success is not null) { <div class="success">@_success</div> }
    @if (_error is not null) { <div class="error-alert">@_error</div> }
    <div class="cards"><section><header><span class="section-icon"><MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" /></span><div><h2>Identificação</h2><p>Dados administrativos da oficina.</p></div></header><dl><div><dt>Nome</dt><dd>@_garage.Name</dd></div><div><dt>Documento</dt><dd>@_garage.Document</dd></div><div><dt>E-mail</dt><dd>@_garage.Email</dd></div><div><dt>Telefone</dt><dd>@_garage.Phone</dd></div><div><dt>Data de criação</dt><dd>@_garage.CreatedAt.ToString("dd/MM/yyyy")</dd></div></dl></section>
    <section><header><span class="section-icon"><MudIcon Icon="@Icons.Material.Filled.ManageAccounts" Size="Size.Small" /></span><div><h2>Conta</h2><p>Proprietário e acessos vinculados.</p></div></header><div class="owner"><span class="owner-avatar">@GetInitial(_garage.OwnerName ?? "Owner")</span><div><strong>@(_garage.OwnerName ?? "Owner não identificado")</strong><small>@(_garage.OwnerEmail ?? "Sem e-mail disponível")</small></div></div><dl><div><dt>Username</dt><dd>@(_garage.OwnerUserName ?? "—")</dd></div><div><dt>Status do acesso</dt><dd>@OwnerStatus(_garage)</dd></div><div><dt>Usuários cadastrados</dt><dd>@_garage.UserCount</dd></div></dl>@if(_garage.OwnerActive == false){<button class="primary" disabled="@_saving" @onclick="ResendOwnerInvitationAsync">@(_saving?"Enviando...":"Reenviar convite de ativação")</button>}</section>
    <section class="status-card"><header><span class="section-icon"><MudIcon Icon="@Icons.Material.Filled.ToggleOn" Size="Size.Small" /></span><div><h2>Status da oficina</h2><p>Controle o acesso dos usuários deste tenant.</p></div></header><div class="status-summary"><span class="status-dot @(_garage.Active ? "on" : "off")"></span><div><strong>@(_garage.Active ? "Oficina ativa" : "Oficina inativa")</strong><small>@(_garage.Active ? "Os usuários podem acessar normalmente." : "Os acessos desta oficina estão suspensos.")</small></div></div>
        @if (!_confirming) { <button class="@(_garage.Active ? "danger-outline" : "primary")" disabled="@_saving" @onclick="RequestStatusChange">@(_garage.Active ? "Desativar oficina" : "Ativar oficina")</button> }
        else { <div class="confirm"><div class="confirm-copy"><MudIcon Icon="@Icons.Material.Filled.WarningAmber" /><div><strong>Confirmar desativação</strong><p>Usuários desta oficina deixarão de acessar o sistema enquanto ela estiver inativa.</p></div></div><div class="confirm-actions"><button @onclick="Cancel">Cancelar</button><button class="danger" disabled="@_saving" @onclick="ChangeStatusAsync">@(_saving ? "Desativando..." : "Confirmar desativação")</button></div></div> }
    </section>
    <section class="subscription-card"><header><span class="section-icon"><MudIcon Icon="@Icons.Material.Filled.CreditCard" Size="Size.Small" /></span><div><h2>Assinatura</h2><p>Plano e situação comercial, separados do status operacional.</p></div></header>
        <div class="subscription-summary"><div><span>Plano</span><strong>Standard</strong></div><div><span>Status</span><strong><em class="subscription-badge @SubscriptionClass(_garage.Subscription.Status)">@SubscriptionLabel(_garage.Subscription.Status)</em></strong></div><div><span>Data de início</span><strong>@_garage.Subscription.StartedAt.ToString("dd/MM/yyyy")</strong></div>@if(_garage.Subscription.TrialEndsAt is { } trialEnd){<div><span>Trial</span><strong>@TrialDescription(_garage.Subscription,trialEnd)</strong></div>}@if(_garage.Subscription.CurrentPeriodStart is { } periodStart){<div><span>Período atual</span><strong>@periodStart.ToString("dd/MM/yyyy") — @(_garage.Subscription.CurrentPeriodEnd?.ToString("dd/MM/yyyy") ?? "—")</strong></div>}</div>
        <div class="subscription-management"><div class="management-head"><strong>Gerenciar assinatura</strong><span>Escolha uma alteração válida para a situação atual.</span></div><div class="subscription-change"><select value="@(_selectedStatus?.ToString()??string.Empty)" @onchange="SelectStatus" disabled="@_saving"><option value="">Alterar situação</option>@foreach(var target in SubscriptionTransitions.AllowedTargets(_garage.Subscription.Status)){<option value="@target">@ActionLabel(_garage.Subscription.Status,target)</option>}</select><button class="primary" disabled="@(_saving||_selectedStatus is null)" @onclick="ConfirmSelectedAsync">@(_saving?"Salvando...":"Confirmar alteração")</button></div>
        @if(_confirmingSubscription){<div class="confirm"><p>@ConfirmationMessage()</p><div class="confirm-actions"><button @onclick="CancelSubscription">Voltar</button><button class="danger" disabled="@_saving" @onclick="SaveSubscriptionAsync">@(_saving?"Salvando...":"Confirmar")</button></div></div>}</div>
    </section>
    <PlatformAuditActivity Items="_garage.RecentActivity" /></div>
}

@code {
    [Parameter] public Guid Id {get;set;} private PlatformGarageDetailsResponse? _garage; private bool _loading=true,_saving,_confirming,_confirmingSubscription; private string? _error,_success; private SubscriptionStatus? _selectedStatus;
    private static string GetInitial(string name)=>string.IsNullOrWhiteSpace(name)?"O":char.ToUpperInvariant(name.Trim()[0]).ToString();
    [SupplyParameterFromQuery] public bool Created {get;set;}
    protected override async Task OnParametersSetAsync(){_loading=true;_error=null;try{_garage=await Service.GetAsync(Id);}catch{_error="Não foi possível carregar a oficina.";}finally{_loading=false;}}
    private async Task RequestStatusChange(){if(_garage is null)return;if(_garage.Active){_confirming=true;return;}await ChangeStatusAsync();}
    private void Cancel()=>_confirming=false;
    private async Task ChangeStatusAsync(){if(_garage is null)return;_saving=true;_success=null;try{var active=!_garage.Active;await Service.SetActiveAsync(Id,active);_garage=await Service.GetAsync(Id);_success=active?"Oficina e assinatura reativadas com sucesso.":"Oficina e assinatura suspensas com sucesso.";_confirming=false;}catch{_error="Não foi possível alterar o status da oficina.";}finally{_saving=false;}}
    private async Task ResendOwnerInvitationAsync(){if(_garage is null||_garage.OwnerActive!=false)return;_saving=true;_error=null;_success=null;try{var result=await Service.ResendOwnerInvitationAsync(Id);_garage=await Service.GetAsync(Id);_success=result.DeliveryStatus==InvitationDeliveryStatus.Sent?"Convite de ativação reenviado.":"Convite preparado, mas o envio falhou. Tente novamente.";}catch{_error="Não foi possível reenviar o convite de ativação.";}finally{_saving=false;}}
    private static string OwnerStatus(PlatformGarageDetailsResponse garage)=>garage.OwnerActive==true?"Ativo":garage.OwnerInvitationDeliveryStatus==InvitationDeliveryStatus.Failed?"Falha no envio · aguardando ativação":"Aguardando ativação";
    private void SelectStatus(ChangeEventArgs args){_selectedStatus=Enum.TryParse<SubscriptionStatus>(args.Value?.ToString(),out var status)?status:null;_confirmingSubscription=false;}
    private async Task ConfirmSelectedAsync(){if(_selectedStatus is SubscriptionStatus.Suspended or SubscriptionStatus.Cancelled){_confirmingSubscription=true;return;}await SaveSubscriptionAsync();}
    private void CancelSubscription()=>_confirmingSubscription=false;
    private async Task SaveSubscriptionAsync(){if(_garage is null||_saving||_selectedStatus is null)return;var status=_selectedStatus.Value;_saving=true;_error=null;_success=null;try{await Service.UpdateSubscriptionAsync(Id,new(status,SubscriptionPlan.Standard));var refreshed=await Service.GetAsync(Id);if(refreshed is null)throw new InvalidOperationException("A oficina não pôde ser recarregada.");_garage=refreshed;_selectedStatus=null;_success=SuccessMessage(status);_confirmingSubscription=false;}catch{_error="Não foi possível alterar a assinatura. Tente novamente.";}finally{_saving=false;}}
    private string ConfirmationMessage()=>_selectedStatus switch{SubscriptionStatus.Suspended=>"A suspensão bloqueará o acesso operacional da oficina. Deseja continuar?",_=>"O cancelamento bloqueará o acesso operacional da oficina. Deseja continuar?"};
    private static string SubscriptionLabel(SubscriptionStatus status)=>status switch{SubscriptionStatus.Trial=>"Trial",SubscriptionStatus.Active=>"Ativa",SubscriptionStatus.PastDue=>"Pendente",SubscriptionStatus.Suspended=>"Suspensa",_=>"Cancelada"};
    private static string SubscriptionClass(SubscriptionStatus status)=>status.ToString().ToLowerInvariant();
    private static string TrialDescription(PlatformSubscriptionResponse subscription,DateTime end){if(subscription.TrialExpired)return $"Trial expirado · Expirou em {end:dd/MM/yyyy}";var days=Math.Max(1,(int)Math.Ceiling((end-DateTime.UtcNow).TotalDays));return $"Trial ativo · Restam {days} {(days==1?"dia":"dias")} · Expira em {end:dd/MM/yyyy}";}
    private static string ActionLabel(SubscriptionStatus current,SubscriptionStatus target)=>target switch{SubscriptionStatus.Active=>current==SubscriptionStatus.Cancelled?"Reativar assinatura":"Ativar assinatura",SubscriptionStatus.PastDue=>"Marcar como pendente",SubscriptionStatus.Suspended=>"Suspender assinatura",_=>"Cancelar assinatura"};
    private static string SuccessMessage(SubscriptionStatus status)=>status switch{SubscriptionStatus.Active=>"Assinatura ativada com sucesso.",SubscriptionStatus.PastDue=>"Assinatura marcada como pendente.",SubscriptionStatus.Suspended=>"Assinatura suspensa com sucesso.",_=>"Assinatura cancelada com sucesso."};
}
