@page "/login"
@layout AuthLayout
@using Microsoft.AspNetCore.Components.Authorization
@using SemBroncaAI.Garage.Web.Services
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>Entrar | SBGarage</PageTitle>

<main class="login-page">
    <section class="login-brand" aria-label="SBGarage">
        <span class="login-brand-icon"><MudIcon Icon="@Icons.Material.Filled.Build" /></span>
        <div><strong>SBGarage</strong><span>Gestão para oficinas</span></div>
    </section>

    <section class="login-card">
        <header>
            <p class="login-eyebrow">ACESSO SEGURO</p>
            <h1>Entre na sua oficina</h1>
            <p>Use seu e-mail ou nome de usuário para continuar.</p>
        </header>

        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <div class="login-alert" role="alert">
                <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Small" />
                <span>@ErrorMessage</span>
            </div>
        }
        @if (Reset)
        {
            <div class="login-success" role="status">Senha redefinida. Entre novamente com sua nova senha.</div>
        }

        <form method="post" action="/auth/login" class="login-form" onsubmit="return sbgLoginSubmitting(this)">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
            <label for="identifier">E-mail ou usuário</label>
            <input id="identifier" name="identifier" type="text" autocomplete="username"
                   required autofocus maxlength="256" />

            <label for="password">Senha</label>
            <div class="login-password-field">
                <input id="password" name="password" type="password" autocomplete="current-password" required maxlength="256" />
                <button type="button" onclick="sbgTogglePassword('password', this)" aria-label="Mostrar senha" title="Mostrar senha"><MudIcon Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" /></button>
            </div>
            <a class="forgot-password-link" href="/forgot-password">Esqueci minha senha</a>

            <label class="remember-option">
                <input type="checkbox" name="rememberMe" value="true" />
                <span>Lembrar meu acesso</span>
            </label>

            <button type="submit" class="login-submit">
                <span class="login-label">Entrar</span>
                <span class="login-loading" aria-live="polite">Entrando...</span>
                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
            </button>
        </form>
    </section>

    <p class="login-footer">Acesso restrito à equipe autorizada da oficina.</p>
</main>

@code {
    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    public bool Reset { get; set; }

    private string ErrorMessage => LoginErrorMessages.Resolve(Error);

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
            Navigation.NavigateTo(AuthorizedLandingPage.Resolve(state.User, ReturnUrl), forceLoad: true);
    }
}
