@page "/forgot-password"
@layout AuthLayout

<PageTitle>Recuperar senha | SemBroncaAI Garage</PageTitle>

<main class="auth-recovery-page">
    <section class="auth-recovery-card">
        <MudIcon Icon="@Icons.Material.Filled.LockReset" Color="Color.Primary" Size="Size.Large" />
        <h1>Esqueci minha senha</h1>
        @if (Error == "unavailable")
        {
            <p role="alert">Não foi possível solicitar a recuperação agora. Tente novamente em alguns instantes.</p>
            <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true">Voltar ao login</MudButton>
        }
        else if (Sent)
        {
            <p>Se existir uma conta associada a este e-mail, enviaremos as instruções para redefinição da senha.</p>
            <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true">Voltar ao login</MudButton>
        }
        else
        {
            <p>Informe o e-mail cadastrado para receber as instruções.</p>
            <form method="post" action="/auth/forgot-password" onsubmit="return sbgLoginSubmitting(this)">
                <AntiforgeryToken />
                <label for="email">E-mail</label>
                <input id="email" name="email" type="email" autocomplete="email" required maxlength="256" autofocus />
                <button type="submit"><span class="login-label">Enviar instruções</span><span class="login-loading">Enviando...</span></button>
            </form>
            <a href="/login">Voltar ao login</a>
        }
    </section>
</main>

@code
{
    [SupplyParameterFromQuery] public bool Sent { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }
}
