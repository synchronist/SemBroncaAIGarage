@page "/team/{Id:guid}"
@attribute [Authorize(Policy = ApplicationPermissions.ManageTeam)]
@using SemBroncaAI.Garage.Application.Abstractions.Security
@using SemBroncaAI.Garage.Application.Features.TeamManagement
@inject TeamService Service
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
<PageTitle>Membro da equipe | SBGarage</PageTitle>
<a class="back" href="/team">← Voltar para equipe</a>
@if(_loading){<div class="state">Carregando...</div>}else if(_member is null){<div class="state">Membro não encontrado.</div>}else{<h1>@_member.Name</h1><p class="intro">@_member.Email · @_member.UserName</p>@if(_error is not null){<div class="error">@_error</div>}@if(_success is not null){<div class="protected">@_success</div>}<div class="card"><label>Nome<input @bind="_name" disabled="@_member.IsCurrentUser" /></label><label>Perfil<select @bind="_role" disabled="@_member.IsCurrentUser"><option value="Receptionist">Recepção</option><option value="Mechanic">Mecânico</option></select></label><label class="switch"><input type="checkbox" @bind="_active" disabled="@_member.IsCurrentUser" /> Usuário ativo</label>@if(_member.IsCurrentUser){<p class="protected">A conta do proprietário principal é protegida contra alteração.</p>}else{<button @onclick="Save" disabled="@_saving">@(_saving?"Salvando...":"Salvar alterações")</button>@if(!_member.Active){<button @onclick="Resend" disabled="@_saving">@(_saving?"Enviando...":"Reenviar convite")</button>}}</div>}
@code{[Parameter]public Guid Id{get;set;}private TeamMemberDetails? _member;private bool _loading=true,_saving,_active;private string _name="",_role="";private string? _error,_success;protected override async Task OnParametersSetAsync(){_loading=true;_member=await Service.GetAsync(Id);if(_member is not null){_name=_member.Name;_role=_member.Role;_active=_member.Active;}_loading=false;}private async Task Save(){_saving=true;_error=null;try{var r=await Service.UpdateAsync(Id,new(_name,_role,_active));if(r.Succeeded)Navigation.NavigateTo("/team");else _error=r.Code=="self-protected"?"O proprietário principal não pode ser alterado.":"Não foi possível salvar as alterações.";}finally{_saving=false;}}private async Task Resend(){if(_saving)return;_saving=true;_error=_success=null;try{var r=await Service.ResendInvitationAsync(Id);if(r.Succeeded){_success="Convite reenviado com sucesso.";Snackbar.Add(_success,Severity.Success);}else _error=r.Errors?.SelectMany(x=>x.Value).FirstOrDefault()??"Não foi possível reenviar o convite. Tente novamente.";}finally{_saving=false;}}}
