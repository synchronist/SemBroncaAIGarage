@page "/service-orders/{Id:guid}"

@attribute [Authorize(Policy = "TenantUser")]
@using SemBroncaAI.Garage.Web.Models
@using SemBroncaAI.Garage.Web.Services

@inject ServiceOrderService ServiceOrderService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject IJSRuntime JS
@inject IDialogService DialogService

<PageTitle>Ordem de serviço</PageTitle>

@if (_isLoading)
{
    <div class="loading-state">
        <MudProgressCircular Indeterminate="true"
                             Color="Color.Primary" />

        <span>Carregando ordem de serviço...</span>
    </div>
}
else if (_serviceOrder is null)
{
    <div class="not-found-state">
        <MudIcon Icon="@Icons.Material.Filled.SearchOff"
                 Size="Size.Large" />

        <h2>Ordem de serviço não encontrada</h2>

        <MudButton Variant="Variant.Outlined"
                   OnClick="GoToServiceOrders">
            Voltar
        </MudButton>
    </div>
}
else
{
    <div class="service-order-page">

        <header class="order-header">

            <div>
                <button class="back-button"
                        type="button"
                        @onclick="GoToServiceOrders">

                    <MudIcon Icon="@Icons.Material.Filled.ArrowBack"
                             Size="Size.Small" />
                </button>

                <div>
                    <span class="order-caption">
                        Ordem de serviço
                    </span>

                    <h1>
                        OS #@_serviceOrder.Number.ToString("D4")
                    </h1>

                    @if (_serviceOrder.ArchivedAt is not null)
                    {
                        <span class="archived-indicator">Arquivada</span>
                    }

                    <span class="order-created">
                        Aberta em
                        @(_serviceOrder.CreatedAt
                            .ToLocalTime()
                            .ToString("dd/MM/yyyy 'às' HH:mm"))
                    </span>
                </div>
            </div>

            <span class="@GetStatusClass(_serviceOrder.Status)">
                @GetStatusLabel(_serviceOrder.Status)
            </span>

            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Print"
                       OnClick="OpenPrintView">
                Imprimir OS
            </MudButton>
            <MudButton Variant="Variant.Outlined" Disabled="_isDownloadingPdf" StartIcon="@Icons.Material.Filled.Download" OnClick="@(() => DownloadPdfAsync(false))">
                @(_isDownloadingPdf ? "Gerando PDF..." : "Baixar OS em PDF")
            </MudButton>

            @if (_serviceOrder.Estimate is not null)
            {
                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.RequestQuote"
                           OnClick="OpenEstimatePrintView">
                    Imprimir orçamento
                </MudButton>
                <MudButton Variant="Variant.Outlined" Disabled="_isDownloadingPdf" StartIcon="@Icons.Material.Filled.Download" OnClick="@(() => DownloadPdfAsync(true))">
                    @(_isDownloadingPdf ? "Gerando PDF..." : "Baixar orçamento em PDF")
                </MudButton>
            }

        </header>

        <section class="summary-grid">

            <article class="summary-card">

                <div class="section-title">
                    <MudIcon Icon="@Icons.Material.Filled.DirectionsCar"
                             Size="Size.Small" />

                    <span>Veículo</span>
                </div>

                <div class="vehicle-summary-title">

                    <strong>
                        @_serviceOrder.Vehicle.Plate
                    </strong>

                    <span>
                        @_serviceOrder.Vehicle.Brand
                        @_serviceOrder.Vehicle.Model
                    </span>

                </div>

                <div class="vehicle-summary-details">

                    <span>
                        @_serviceOrder.Vehicle.Version
                    </span>

                    <span>
                        @_serviceOrder.Vehicle.Year
                    </span>

                    <span>
                        @_serviceOrder.Vehicle.Color
                    </span>

                    <span>
                        @_serviceOrder.Vehicle.Fuel
                    </span>

                </div>

                <div class="vehicle-mileage">
                    <small>Quilometragem na entrada</small>
                    <span>@(_serviceOrder.Mileage.HasValue ? $"{_serviceOrder.Mileage.Value:N0} km" : "Não registrada")</span>
                </div>

            </article>

            <article class="summary-card">

                <div class="section-title">

                    <MudIcon Icon="@Icons.Material.Filled.PersonOutline"
                             Size="Size.Small" />

                    <span>Cliente</span>

                </div>

                <strong class="customer-name">
                    @_serviceOrder.Customer.Name
                </strong>

                <div class="customer-details">

                    <span>
                        <small>Telefone</small>
                        @FormatPhone(_serviceOrder.Customer.Phone)
                    </span>

                    <span>
                        <small>Documento</small>
                        @_serviceOrder.Customer.Document
                    </span>

                    <span>
                        <small>E-mail</small>
                        @_serviceOrder.Customer.Email
                    </span>

                </div>

            </article>

        </section>

        <section class="content-card">

            <div class="section-title">

                <MudIcon Icon="@Icons.Material.Filled.Description"
                         Size="Size.Small" />

                <span>Relato do cliente</span>

            </div>

            <p class="complaint">
                @_serviceOrder.CustomerComplaint
            </p>

        </section>


        @if (_serviceOrder.Status == "Diagnosis" ||
             _serviceOrder.Diagnosis is not null)
        {
            <section class="content-card diagnosis-card">

                <div class="section-heading">

                    <div class="section-title">

                        <MudIcon Icon="@Icons.Material.Filled.Build"
                                 Size="Size.Small" />

                        <span>Diagnóstico do veículo</span>

                    </div>

                    @if (_serviceOrder.Diagnosis is not null)
                    {
                        <span class="diagnosis-saved">
                            Diagnóstico salvo
                        </span>
                    }

                </div>

                @if (_serviceOrder.Status == "Diagnosis")
                {
                    <div class="diagnosis-form">

                        <MudTextField T="string"
                                      @bind-Value="_diagnosisDescription"
                                      Label="O que foi identificado?"
                                      Placeholder="Descreva o problema encontrado durante o diagnóstico..."
                                      Variant="Variant.Outlined"
                                      Lines="5"
                                      Immediate="true" />

                        <div class="internal-notes-field">

                            <MudTextField T="string"
                                          @bind-Value="_diagnosisInternalNotes"
                                          Label="Observações internas"
                                          Placeholder="Informações para a equipe da oficina..."
                                          Variant="Variant.Outlined"
                                          Lines="3"
                                          Immediate="true" />

                            <span>
                                Uso interno da oficina. Estas observações não serão exibidas ao cliente.
                            </span>

                        </div>

                        <div class="diagnosis-actions">

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Save"
                                       Disabled="@(_isSavingDiagnosis ||
                                                   string.IsNullOrWhiteSpace(_diagnosisDescription))"
                                       OnClick="SaveDiagnosisAsync">

                                @if (_isSavingDiagnosis)
                                {
                                    <MudProgressCircular Indeterminate="true"
                                                         Size="Size.Small" />

                                    <span>Salvando...</span>
                                }
                                else
                                {
                                    <span>
                                        @(_serviceOrder.Diagnosis is null
                                            ? "Salvar diagnóstico"
                                            : "Atualizar diagnóstico")
                                    </span>
                                }

                            </MudButton>

                        </div>


                    </div>
                }
                else if (_serviceOrder.Diagnosis is not null)
                {
                    <div class="diagnosis-readonly">

                        <div>
                            <small>Diagnóstico</small>

                            <p>
                                @_serviceOrder.Diagnosis.Description
                            </p>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(
                            _serviceOrder.Diagnosis.InternalNotes))
                        {
                            <div class="diagnosis-internal-readonly">

                                <small>
                                    Observações internas
                                </small>

                                <p>
                                    @_serviceOrder.Diagnosis.InternalNotes
                                </p>

                            </div>
                        }

                    </div>
                }

            </section>
        }

        @if (_serviceOrder.Diagnosis is not null ||
             _serviceOrder.Estimate is not null)
        {
            <section class="content-card estimate-card">
                <div class="section-heading">
                    <div class="section-title">
                        <MudIcon Icon="@Icons.Material.Filled.RequestQuote"
                                 Size="Size.Small" />
                        <span>Orçamento</span>
                    </div>

                    @if (_serviceOrder.Estimate is not null)
                    {
                        <span class="diagnosis-saved">Orçamento salvo</span>
                    }
                </div>

                @if (_serviceOrder.Status == "Diagnosis")
                {
                    <div class="estimate-editor">
                        <div class="estimate-table-header">
                            <span>Tipo</span>
                            <span>Descrição</span>
                            <span>Quantidade</span>
                            <span>Valor unitário</span>
                            <span>Total</span>
                            <span></span>
                        </div>

                        @foreach (var item in _estimateItems)
                        {
                            <div class="estimate-row" @key="item.Key">
                                <MudSelect T="int"
                                           @bind-Value="item.Type"
                                           Variant="Variant.Outlined"
                                           Dense="true">
                                    <MudSelectItem T="int" Value="1">Serviço</MudSelectItem>
                                    <MudSelectItem T="int" Value="2">Peça</MudSelectItem>
                                </MudSelect>

                                <MudTextField T="string"
                                              @bind-Value="item.Description"
                                              Placeholder="Descrição do item"
                                              Variant="Variant.Outlined"
                                              Immediate="true" />

                                <MudNumericField T="decimal"
                                                 @bind-Value="item.Quantity"
                                                 Variant="Variant.Outlined"
                                                 Min="0.001m"
                                                 Step="0.1m"
                                                 HideSpinButtons="true" />

                                <MudNumericField T="decimal"
                                                 @bind-Value="item.UnitPrice"
                                                 Variant="Variant.Outlined"
                                                 Min="0.01m"
                                                 Step="0.01m"
                                                 HideSpinButtons="true"
                                                 Adornment="Adornment.Start"
                                                 AdornmentText="R$" />

                                <strong class="estimate-line-total">
                                    @FormatCurrency(item.Total)
                                </strong>

                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               OnClick="@(() => RemoveEstimateItem(item))" />
                            </div>
                        }

                        <MudButton Variant="Variant.Outlined"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="AddEstimateItem">
                            Adicionar item
                        </MudButton>

                        <div class="estimate-footer">
                            <div class="estimate-totals">
                                <span>Serviços <strong>@FormatCurrency(EstimateServicesSubtotal)</strong></span>
                                <span>Peças <strong>@FormatCurrency(EstimatePartsSubtotal)</strong></span>
                                <span class="estimate-grand-total">Total <strong>@FormatCurrency(EstimateTotal)</strong></span>
                            </div>

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Save"
                                       Disabled="@(_isSavingEstimate || !CanSaveEstimate)"
                                       OnClick="SaveEstimateAsync">
                                @(_isSavingEstimate ? "Salvando..." : "Salvar orçamento")
                            </MudButton>
                        </div>
                    </div>
                }
                else if (_serviceOrder.Estimate is not null)
                {
                    <div class="estimate-readonly">
                        @foreach (var item in _serviceOrder.Estimate.Items)
                        {
                            <div class="estimate-readonly-row">
                                <span class="estimate-type">@(item.Type == "Service" ? "Serviço" : "Peça")</span>
                                <span>
                                    <strong>@item.Description</strong>
                                    <small>@FormatQuantity(item.Quantity) × @FormatCurrency(item.UnitPrice)</small>
                                </span>
                                <strong>@FormatCurrency(item.Total)</strong>
                            </div>
                        }

                        <div class="estimate-totals">
                            <span>Serviços <strong>@FormatCurrency(_serviceOrder.Estimate.ServicesSubtotal)</strong></span>
                            <span>Peças <strong>@FormatCurrency(_serviceOrder.Estimate.PartsSubtotal)</strong></span>
                            <span class="estimate-grand-total">Total <strong>@FormatCurrency(_serviceOrder.Estimate.Total)</strong></span>
                        </div>
                    </div>
                }
            </section>
        }

        <section class="content-card">

            <div class="section-heading">

                <div class="section-title">

                    <MudIcon Icon="@Icons.Material.Filled.History"
                             Size="Size.Small" />

                    <span>Histórico da ordem</span>

                </div>

                <span class="history-count">
                    @_serviceOrder.History.Count registros
                </span>

            </div>

            <div class="timeline">

                @{
                    var orderedHistory =
                        _serviceOrder.History
                            .OrderByDescending(
                                item => item.CreatedAt);
                }

                @foreach (var history in orderedHistory)
                {
                    <div class="timeline-item">

                        <div class="@GetTimelineMarkerClass(history.ToStatus)"></div>

                        <div class="timeline-content">

                            <div class="timeline-header">

                                <strong>
                                    @GetStatusLabel(history.ToStatus)
                                </strong>

                                <span>
                                    @(history.CreatedAt
                                        .ToLocalTime()
                                        .ToString("dd/MM/yyyy HH:mm"))
                                </span>

                            </div>

                            <p>
                                @history.Description
                            </p>

                            @if (!string.IsNullOrWhiteSpace(
                                history.FromStatus))
                            {
                                <small>
                                    @GetStatusLabel(history.FromStatus!)
                                    →
                                    @GetStatusLabel(history.ToStatus)
                                </small>
                            }

                        </div>

                    </div>
                }

            </div>

        </section>

        @if (_serviceOrder.Approval is not null)
        {
            <section class="approval-office-card">
                <div><span class="action-caption">Aprovação do cliente</span><strong>@ApprovalStatusLabel</strong>
                    <small>Enviado em @_serviceOrder.Approval.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy 'às' HH:mm")</small>
                    @if (_serviceOrder.Approval.RespondedAt is not null) { <small>Respondido em @_serviceOrder.Approval.RespondedAt.Value.ToLocalTime().ToString("dd/MM/yyyy 'às' HH:mm")</small> }
                    @if (!string.IsNullOrWhiteSpace(_serviceOrder.Approval.CustomerComment)) { <p><b>Motivo:</b> @_serviceOrder.Approval.CustomerComment</p> }
                </div>
                <div class="action-buttons">
                    @if (_serviceOrder.Approval.Token is not null)
                    {
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="CopyApprovalLinkAsync">Copiar link</MudButton>
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.OpenInNew" OnClick="OpenApprovalPage">Abrir página do cliente</MudButton>
                    }
                    @if (_serviceOrder.Approval.Status == "Rejected" || ApprovalExpired)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ReviseEstimateAsync">Revisar orçamento</MudButton>
                    }
                </div>
                @if ((_serviceOrder.ApprovalHistory?.Count ?? 0) > 1)
                {
                    <details class="approval-history">
                        <summary>Ver histórico (@_serviceOrder.ApprovalHistory!.Count)</summary>
                        <div>
                            @foreach (var approval in _serviceOrder.ApprovalHistory.Select((value, index) => (value, index)))
                            {
                                <article>
                                    <span>@(_serviceOrder.ApprovalHistory.Count - approval.index)º envio</span>
                                    <strong>@GetApprovalHistoryStatus(approval.value)</strong>
                                    <small>@approval.value.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy 'às' HH:mm")</small>
                                    @if (!string.IsNullOrWhiteSpace(approval.value.CustomerComment)) { <p>“@approval.value.CustomerComment”</p> }
                                </article>
                            }
                        </div>
                    </details>
                }
            </section>
        }

        <section class="action-card">

            <div>

                <span class="action-caption">
                    Próxima etapa
                </span>

                <strong>
                    @GetNextActionDescription()
                </strong>

            </div>

            <div class="action-buttons">

                @if (CanCancel)
                {
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Error"
                               Disabled="_isTransitioning"
                               OnClick="CancelAsync">
                        Cancelar OS
                    </MudButton>
                }

                @if (_serviceOrder.Status == "InProgress")
                {
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Warning"
                               Disabled="_isTransitioning"
                               StartIcon="@Icons.Material.Filled.Inventory2"
                               OnClick="WaitForPartsAsync">
                        Aguardar peças
                    </MudButton>
                }

                @if (HasPrimaryAction)
                {
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Disabled="@IsPrimaryActionDisabled"
                               StartIcon="@GetPrimaryActionIcon()"
                               OnClick="ExecutePrimaryActionAsync">

                        @if (_isTransitioning)
                        {
                            <MudProgressCircular Indeterminate="true"
                                                 Size="Size.Small" />
                        }
                        else
                        {
                            @GetPrimaryActionLabel()
                        }

                    </MudButton>
                }

            </div>

        </section>

        @if (_serviceOrder.ArchivedAt is not null || _serviceOrder.Status is "Delivered" or "Cancelled")
        {
            <section class="archive-card">
                <div><span class="action-caption">Organização</span><strong>@(_serviceOrder.ArchivedAt is null ? "Retirar esta OS da operação diária" : "Esta OS está arquivada")</strong>
                    <small>@(_serviceOrder.ArchivedAt is null ? "Todos os dados, documentos e históricos continuarão preservados." : $"Arquivada em {_serviceOrder.ArchivedAt.Value.ToLocalTime():dd/MM/yyyy 'às' HH:mm}.")</small></div>
                @if (_serviceOrder.ArchivedAt is null)
                {
                    <MudButton Class="archive-action" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Archive" OnClick="ArchiveAsync">Arquivar OS</MudButton>
                }
                else
                {
                    <MudButton Class="restore-action" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Unarchive" OnClick="RestoreAsync">Restaurar OS</MudButton>
                }
            </section>
        }

    </div>
}

@code {

    [Parameter]
    public Guid Id { get; set; }

    private ServiceOrderDetailsModel? _serviceOrder;

    private bool _isLoading = true;

    private bool _isTransitioning;

    private bool _isSavingDiagnosis;

    private bool _isSavingEstimate;
    private bool _isDownloadingPdf;

    private readonly List<EstimateItemEditModel> _estimateItems = [];

    private string _diagnosisDescription = string.Empty;

    private string _diagnosisInternalNotes = string.Empty;

    private bool HasPrimaryAction =>
        _serviceOrder?.Status is
            "Received" or
            "Diagnosis" or
            "WaitingApproval" or
            "InProgress" or
            "WaitingParts" or
            "Finished";

    private bool CanCancel =>
        _serviceOrder?.Status is not
            null and not
            "Delivered" and not
            "Cancelled";

    private bool IsPrimaryActionDisabled =>
        _isTransitioning ||
        _isSavingDiagnosis ||
        (_serviceOrder?.Status == "Diagnosis" &&
         (_serviceOrder.Diagnosis is null ||
          _serviceOrder.Estimate is null)) ||
        (_serviceOrder?.Status == "WaitingApproval" && _serviceOrder.Approval?.Status != "Approved");

    private bool ApprovalExpired => _serviceOrder?.Approval is { Status: "Pending" } approval && DateTimeOffset.UtcNow >= approval.ExpiresAt;
    private string ApprovalStatusLabel => ApprovalExpired ? "Link expirado" : _serviceOrder?.Approval?.Status switch
    { "Pending" => "Aguardando aprovação", "Approved" => "✓ Aprovado pelo cliente", "Rejected" => "✕ Recusado", _ => "Link invalidado" };
    private string ApprovalLink => new Uri(new Uri(Navigation.BaseUri), $"approval/{_serviceOrder!.Approval!.Token}").ToString();

    private async Task CopyApprovalLinkAsync()
    {
        await JS.InvokeVoidAsync("sbgCopyText", ApprovalLink);
        Snackbar.Add("Link copiado.", Severity.Success);
    }
    private void OpenApprovalPage() => Navigation.NavigateTo(ApprovalLink, true);
    private Task ReviseEstimateAsync() => ExecuteTransitionAsync("revise-estimate");

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _isLoading = true;

            _serviceOrder =
                await ServiceOrderService.GetByIdAsync(Id);

            if (_serviceOrder?.Diagnosis is not null)
            {
                _diagnosisDescription =
                    _serviceOrder.Diagnosis.Description;

                _diagnosisInternalNotes =
                    _serviceOrder.Diagnosis.InternalNotes;
            }
            else
            {
                _diagnosisDescription = string.Empty;
                _diagnosisInternalNotes = string.Empty;
            }

            _estimateItems.Clear();

            if (_serviceOrder?.Estimate is not null)
            {
                _estimateItems.AddRange(_serviceOrder.Estimate.Items.Select(item =>
                    new EstimateItemEditModel
                    {
                        Description = item.Description,
                        Type = GetEstimateItemTypeValue(item.Type),
                        Quantity = item.Quantity,
                        UnitPrice = item.UnitPrice
                    }));
            }
            else if (_serviceOrder?.Diagnosis is not null)
            {
                AddEstimateItem();
            }
        }
        catch (Exception exception)
        {
            Snackbar.Add(
                exception.Message,
                Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private decimal EstimateServicesSubtotal =>
        _estimateItems.Where(item => item.Type == 1).Sum(item => item.Total);

    private decimal EstimatePartsSubtotal =>
        _estimateItems.Where(item => item.Type == 2).Sum(item => item.Total);

    private decimal EstimateTotal => EstimateServicesSubtotal + EstimatePartsSubtotal;

    private bool CanSaveEstimate =>
        _estimateItems.Count > 0 &&
        _estimateItems.All(item =>
            !string.IsNullOrWhiteSpace(item.Description) &&
            item.Type is 1 or 2 &&
            item.Quantity > 0 &&
            item.UnitPrice > 0);

    private void AddEstimateItem() => _estimateItems.Add(new EstimateItemEditModel());

    private void RemoveEstimateItem(EstimateItemEditModel item) => _estimateItems.Remove(item);

    private async Task SaveEstimateAsync()
    {
        if (!CanSaveEstimate)
        {
            Snackbar.Add("Preencha ao menos um item válido no orçamento.", Severity.Warning);
            return;
        }

        try
        {
            _isSavingEstimate = true;
            await ServiceOrderService.SaveEstimateAsync(
                Id,
                _estimateItems.Select(item => new SaveEstimateItemRequest(
                    item.Description.Trim(),
                    item.Type,
                    item.Quantity,
                    item.UnitPrice)).ToArray());

            Snackbar.Add("Orçamento salvo com sucesso.", Severity.Success);
            await LoadAsync();
        }
        catch (HttpRequestException exception)
        {
            Snackbar.Add($"Não foi possível salvar o orçamento: {exception.Message}", Severity.Error);
        }
        finally
        {
            _isSavingEstimate = false;
        }
    }

    private static readonly System.Globalization.CultureInfo BrazilianCulture =
        System.Globalization.CultureInfo.GetCultureInfo("pt-BR");

    private static string FormatCurrency(decimal value) =>
        value.ToString("C2", BrazilianCulture);

    private static string FormatQuantity(decimal value) =>
        value.ToString("0.###", BrazilianCulture);

    private static int GetEstimateItemTypeValue(string type) =>
        type switch
        {
            "Service" => 1,
            "Part" => 2,
            _ => throw new InvalidOperationException(
                $"Tipo de item de orçamento desconhecido: {type}.")
    };

    private static string GetApprovalHistoryStatus(ServiceOrderApprovalHistoryModel approval)
    {
        if (approval.InvalidatedAt is not null && approval.Status == "Pending") return "Substituído por novo envio";
        if (approval.Status == "Pending" && approval.ExpiresAt <= DateTimeOffset.UtcNow) return "Expirado";
        return approval.Status switch { "Pending" => "Aguardando aprovação", "Approved" => "Aprovado", "Rejected" => "Recusado", _ => approval.Status };
    }

    private async Task SaveDiagnosisAsync()
    {
        if (_serviceOrder is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(
            _diagnosisDescription))
        {
            Snackbar.Add(
                "Informe o diagnóstico do veículo.",
                Severity.Warning);

            return;
        }

        try
        {
            _isSavingDiagnosis = true;

            await ServiceOrderService.SaveDiagnosisAsync(
                Id,
                _diagnosisDescription,
                _diagnosisInternalNotes);

            Snackbar.Add(
                "Diagnóstico salvo com sucesso.",
                Severity.Success);

            await LoadAsync();
        }
        catch (HttpRequestException exception)
        {
            Snackbar.Add(
                $"Não foi possível salvar o diagnóstico: {exception.Message}",
                Severity.Error);
        }
        finally
        {
            _isSavingDiagnosis = false;
        }
    }


    private async Task ExecutePrimaryActionAsync()
    {
        if (_serviceOrder is null)
        {
            return;
        }

        var action =
            GetPrimaryActionRoute();

        if (action is null)
        {
            return;
        }

        await ExecuteTransitionAsync(action);
    }

    private async Task CancelAsync()
    {
        await ExecuteTransitionAsync("cancel");
    }

    private async Task WaitForPartsAsync()
    {
        await ExecuteTransitionAsync("wait-for-parts");
    }

    private async Task ExecuteTransitionAsync(
        string action)
    {
        try
        {
            _isTransitioning = true;

            await ServiceOrderService
                .ExecuteTransitionAsync(
                    Id,
                    action);

            Snackbar.Add(
                "Ordem de serviço atualizada.",
                Severity.Success);

            await LoadAsync();
        }
        catch (HttpRequestException exception)
        {
            Snackbar.Add(
                $"Não foi possível atualizar a OS: {exception.Message}",
                Severity.Error);
        }
        finally
        {
            _isTransitioning = false;
        }
    }

