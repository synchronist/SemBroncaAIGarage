    private async Task DownloadPdfAsync(bool estimate)
    {
        if (_isDownloadingPdf) return;
        try
        {
            _isDownloadingPdf = true;
            var download = await ServiceOrderService.DownloadPdfAsync(Id, estimate);
            await JS.InvokeVoidAsync("sbgDownloadFile", download.FileName, "application/pdf", Convert.ToBase64String(download.Content));
        }
        catch (Exception exception) { Snackbar.Add(exception.Message, Severity.Error); }
        finally { _isDownloadingPdf = false; }
    }

    private async Task ArchiveAsync()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync("Arquivar ordem de serviço",
            "Arquivar esta ordem de serviço? Ela sairá da listagem principal, mas continuará disponível para consulta.",
            yesText: "Arquivar", cancelText: "Cancelar");
        if (confirmed != true) return;
        await SetArchivedAsync(true);
    }

    private Task RestoreAsync() => SetArchivedAsync(false);

    private async Task SetArchivedAsync(bool archived)
    {
        if (_serviceOrder is null) return;
        try
        {
            await ServiceOrderService.SetArchivedAsync(Id, archived);
            Snackbar.Add(archived ? "Ordem de serviço arquivada." : "Ordem de serviço restaurada.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception exception) { Snackbar.Add(exception.Message, Severity.Error); }
    }

