@page "/platform-admin/sites/new"
@page "/platform-admin/sites/{Id:guid}"
@layout PlatformAdminLayout
@attribute [Authorize(Policy=PlatformAuthorization.Policy)]
@using SemBroncaAI.Garage.Application.Abstractions.Security
@using SemBroncaAI.Garage.Application.Features.SiteManagement
@using SemBroncaAI.Garage.Domain.Entities.SiteManagement
@using SemBroncaAI.Garage.Web.Models
@using SemBroncaAI.Garage.Web.Components.Shared
@inject PlatformSiteService Service
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
<PageTitle>@(Id is null?"Novo site":"Editar site") | SemBroncaAI</PageTitle>
<div class="edit-page"><a class="back" href="/platform-admin/sites"><MudIcon Icon="@Icons.Material.Filled.ArrowBack"/>Voltar</a><div class="page-head"><div><span class="eyebrow">GERENCIADOR DE SITES</span><h1>@(Id is null?"Novo site / cliente":_model.TradeName)</h1><p>Informações comerciais e operacionais sem armazenamento de senhas.</p></div><MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving" OnClick="SaveAsync">@(_saving?"Salvando...":"Salvar")</MudButton></div>
@if(_loading){<div class="state"><MudProgressCircular Indeterminate="true"/><strong>Carregando cadastro</strong></div>}else{
<MudTabs Class="site-tabs" Rounded="true" Elevation="0" ApplyEffectsToContainer="true" @bind-ActivePanelIndex="_activeTab" KeepPanelsAlive="true">
 <MudTabPanel Text="Cliente"><div class="form-grid"><MudTextField @bind-Value="_model.TradeName" Label="Nome fantasia" Required="true"/><MudTextField @bind-Value="_model.LegalName" Label="Razão social"/><MudTextField @bind-Value="_model.Document" Label="CPF/CNPJ"/><MudTextField @bind-Value="_model.ContactName" Label="Responsável"/><MudTextField @bind-Value="_model.Phone" Label="Telefone" InputMode="InputMode.tel"/><MudTextField @bind-Value="_model.WhatsApp" Label="WhatsApp" InputMode="InputMode.tel"/><MudTextField @bind-Value="_model.Email" Label="E-mail" InputType="InputType.Email"/><MudTextField Class="wide" @bind-Value="_model.Notes" Label="Observações" Lines="3"/></div></MudTabPanel>
 <MudTabPanel Text="Projeto"><div class="form-grid"><MudTextField @bind-Value="_model.ProjectName" Label="Nome do projeto" Required="true"/><MudTextField @bind-Value="_model.Domain" Label="Domínio" Required="true"/><MudTextField @bind-Value="_model.SiteType" Label="Tipo do site"/><MudSelect T="ManagedSiteStatus" @bind-Value="_model.Status" Label="Status">@foreach(var v in Enum.GetValues<ManagedSiteStatus>()){<MudSelectItem Value="v">@v</MudSelectItem>}</MudSelect><MudTextField Class="wide" @bind-Value="_model.Scope" Label="Escopo resumido" Lines="3"/><DateField Label="Contratação" @bind-Value="_model.ContractedOn"/><DateField Label="Início" @bind-Value="_model.StartedOn"/><DateField Label="Previsão de entrega" @bind-Value="_model.ExpectedDeliveryOn"/><DateField Label="Publicação" @bind-Value="_model.PublishedOn"/><MudNumericField T="int" @bind-Value="_model.ContractedRevisions" Label="Revisões contratadas" Min="0"/><MudNumericField T="int" @bind-Value="_model.UsedRevisions" Label="Revisões utilizadas" Min="0"/></div></MudTabPanel>
 <MudTabPanel Text="Infraestrutura"><h3>Domínio e DNS</h3><div class="form-grid"><MudTextField @bind-Value="_model.DomainRegistrar" Label="Registrador"/><MudTextField @bind-Value="_model.DomainHolder" Label="Titular"/><MudCheckBox @bind-Value="_model.DomainManagedByClient" Label="Administrado pelo cliente"/><DateField Label="Renovação do domínio" @bind-Value="_model.DomainRenewalOn"/><MudNumericField T="decimal" @bind-Value="_model.DomainCost" Label="Custo do domínio" Min="0" Adornment="Adornment.Start" AdornmentText="R$"/><MudTextField @bind-Value="_model.DnsProvider" Label="Provedor DNS"/><MudTextField Class="wide" @bind-Value="_model.DomainNotes" Label="Observações do domínio"/><MudTextField Class="wide" @bind-Value="_model.DnsNotes" Label="Observações DNS"/></div><h3>Hospedagem e deploy</h3><div class="form-grid"><MudTextField @bind-Value="_model.HostingProvider" Label="Provedor"/><MudTextField @bind-Value="_model.HostingPlan" Label="Plano"/><MudTextField @bind-Value="_model.HostingAdminUrl" Label="URL do painel"/><MudNumericField T="decimal" @bind-Value="_model.HostingCost" Label="Custo" Min="0"/><EnumSelect T="ManagedSitePeriodicity" Label="Periodicidade" @bind-Value="_model.HostingPeriodicity"/><DateField Label="Próxima renovação" @bind-Value="_model.HostingRenewalOn"/><EnumSelect T="ManagedSiteResourceStatus" Label="Status da hospedagem" @bind-Value="_model.HostingStatus"/><MudTextField @bind-Value="_model.DeployPlatform" Label="Plataforma de deploy"/><MudTextField @bind-Value="_model.ProductionUrl" Label="URL de produção"/><MudTextField @bind-Value="_model.StagingUrl" Label="URL de staging"/><MudTextField @bind-Value="_model.RepositoryUrl" Label="Repositório"/><MudTextField @bind-Value="_model.ProductionBranch" Label="Branch de produção"/><MudTextField Class="wide" @bind-Value="_model.DeployNotes" Label="Observações do deploy"/><MudTextField Class="wide" @bind-Value="_model.CredentialReference" Label="Referência segura da credencial" HelperText="Nunca informe a senha; registre apenas onde ela está armazenada."/><EnumSelect T="ManagedSiteResourceStatus" Label="Status SSL" @bind-Value="_model.SslStatus"/><DateField Label="Vencimento SSL" @bind-Value="_model.SslExpiresOn"/></div></MudTabPanel>
 <MudTabPanel Text="E-mails"><div class="form-grid"><MudTextField @bind-Value="_model.EmailProvider" Label="Provedor"/><MudTextField @bind-Value="_model.EmailPlan" Label="Plano"/><MudNumericField T="int" @bind-Value="_model.EmailIncludedCount" Label="Quantidade incluída" Min="0"/><MudNumericField T="decimal" @bind-Value="_model.EmailCost" Label="Custo" Min="0"/><EnumSelect T="ManagedSitePeriodicity" Label="Periodicidade" @bind-Value="_model.EmailPeriodicity"/><DateField Label="Próxima renovação" @bind-Value="_model.EmailRenewalOn"/><EnumSelect T="ManagedSiteResourceStatus" Label="Status" @bind-Value="_model.EmailStatus"/></div><CollectionHeader Title="Caixas de e-mail" OnAdd="AddMailbox"/>@foreach(var item in _model.Mailboxes.Select((v,i)=>(v,i))){<div class="collection-row"><span><strong>@item.v.Address</strong><small>@item.v.Type · @item.v.Status · @item.v.OwnerName</small></span><button @onclick="()=>_model.Mailboxes.RemoveAt(item.i)">Remover</button></div>}@if(_addingMailbox){<div class="inline-form"><MudTextField @bind-Value="_mailAddress" Label="Endereço"/><MudTextField @bind-Value="_mailOwner" Label="Responsável"/><EnumSelect T="ManagedSiteMailboxType" Label="Tipo" @bind-Value="_mailType"/><EnumSelect T="ManagedSiteResourceStatus" Label="Status" @bind-Value="_mailStatus"/><MudTextField @bind-Value="_mailNotes" Label="Observações"/><MudButton OnClick="ConfirmMailbox">Adicionar</MudButton></div>}</MudTabPanel>
 <MudTabPanel Text="Financeiro"><div class="form-grid"><MudNumericField T="decimal" @bind-Value="_model.DevelopmentContractValue" Label="Valor contratado" Min="0"/><MudNumericField T="decimal" @bind-Value="_model.DevelopmentReceivedValue" Label="Valor recebido" Min="0"/><MudTextField @bind-Value="_model.PaymentMethod" Label="Forma de pagamento"/><MudTextField @bind-Value="_model.PaymentTerms" Label="Condição"/><MudTextField @bind-Value="_model.DevelopmentPaymentStatus" Label="Status do desenvolvimento"/><MudNumericField T="decimal" @bind-Value="_model.MonthlyFee" Label="Mensalidade" Min="0"/><MudNumericField T="decimal" @bind-Value="_model.EstimatedRecurringCost" Label="Outros custos recorrentes estimados" Min="0"/><MudNumericField T="int" @bind-Value="_model.DueDay" Label="Dia do vencimento" Min="1" Max="31"/><DateField Label="Próxima cobrança" @bind-Value="_model.NextChargeOn"/><EnumSelect T="ManagedSiteFinancialStatus" Label="Situação financeira" @bind-Value="_model.FinancialStatus"/></div>@if(_details is not null){<div class="financial-summary"><span>Saldo<strong>@Money(_details.DevelopmentBalance)</strong></span><span>Custo recorrente<strong>@Money(_details.RecurringCost)</strong></span><span>Margem recorrente<strong>@Money(_details.RecurringMargin)</strong></span><span>Margem %<strong>@_details.MarginPercent.ToString("N1")%</strong></span></div>}<CollectionHeader Title="Custos associados" OnAdd="AddCost"/>@foreach(var item in _model.Costs.Select((v,i)=>(v,i))){<div class="collection-row"><span><strong>@item.v.Description</strong><small>@item.v.Category · @Money(item.v.Value) · @item.v.Periodicity · @item.v.Supplier</small></span><button @onclick="()=>_model.Costs.RemoveAt(item.i)">Remover</button></div>}@if(_addingCost){<div class="inline-form"><MudTextField @bind-Value="_costDescription" Label="Descrição"/><MudTextField @bind-Value="_costCategory" Label="Categoria"/><MudTextField @bind-Value="_costSupplier" Label="Fornecedor"/><MudNumericField T="decimal" @bind-Value="_costValue" Label="Valor" Min="0"/><EnumSelect T="ManagedSitePeriodicity" Label="Periodicidade" @bind-Value="_costPeriodicity"/><DateField Label="Próxima renovação" @bind-Value="_costRenewal"/><MudTextField @bind-Value="_costNotes" Label="Observações"/><MudButton OnClick="ConfirmCost">Adicionar</MudButton></div>}</MudTabPanel>
 <MudTabPanel Text="Contrato"><div class="form-grid"><MudCheckBox @bind-Value="_model.HasContract" Label="Possui contrato"/><EnumSelect T="ManagedSiteContractStatus" Label="Status" @bind-Value="_model.ContractStatus"/><DateField Label="Início" @bind-Value="_model.ContractStartOn"/><DateField Label="Assinatura" @bind-Value="_model.ContractSignedOn"/><MudNumericField T="int" @bind-Value="_model.ContractTermMonths" Label="Prazo (meses)" Min="0"/><MudNumericField T="int" @bind-Value="_model.CancellationNoticeDays" Label="Aviso prévio (dias)" Min="0"/><MudNumericField T="int" @bind-Value="_model.IncludedRevisions" Label="Revisões incluídas" Min="0"/><MudNumericField T="decimal" @bind-Value="_model.MonthlySupportHours" Label="Suporte mensal (horas)" Min="0"/><MudTextField Class="wide" @bind-Value="_model.ContractNotes" Label="Observações" Lines="3"/></div><p class="hint">Estrutura preparada para referência futura a PDF; nenhum arquivo ou senha é armazenado nesta V1.</p></MudTabPanel>
 <MudTabPanel Text="Suporte"><div class="support-summary">Horas usadas no mês: <strong>@(_details?.SupportHoursThisMonth.ToString("N1")??"0")</strong> · saldo: <strong>@(_details?.SupportHoursRemaining.ToString("N1")??_model.MonthlySupportHours.ToString("N1"))</strong></div><CollectionHeader Title="Atendimentos" OnAdd="AddSupport"/>@foreach(var item in _model.SupportEntries.Select((v,i)=>(v,i))){<div class="collection-row"><span><strong>@item.v.Type · @item.v.OccurredAt.ToString("dd/MM/yyyy")</strong><small>@item.v.Description · @item.v.HoursSpent.ToString("N1")h · @item.v.Status</small></span><button @onclick="()=>_model.SupportEntries.RemoveAt(item.i)">Remover</button></div>}@if(_addingSupport){<div class="inline-form"><MudTextField @bind-Value="_supportType" Label="Tipo"/><MudTextField @bind-Value="_supportDescription" Label="Descrição"/><MudNumericField T="decimal" @bind-Value="_supportHours" Label="Horas" Min="0"/><MudCheckBox @bind-Value="_supportBillable" Label="Faturável"/><MudNumericField T="decimal" @bind-Value="_supportValue" Label="Valor adicional" Min="0"/><MudTextField @bind-Value="_supportStatus" Label="Status"/><MudTextField @bind-Value="_supportNotes" Label="Observações"/><MudButton OnClick="ConfirmSupport">Adicionar</MudButton></div>}</MudTabPanel>
 <MudTabPanel Text="Histórico">@if(Id is not null){<div class="history-add"><MudTextField @bind-Value="_historyText" Label="Nova anotação" Lines="2"/><MudButton OnClick="AddHistoryAsync">Registrar</MudButton></div>@foreach(var item in _details?.History??[]){<div class="history-item"><strong>@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong><span>@item.Text</span></div>}}else{<p class="hint">Salve o cadastro para começar o histórico.</p>}</MudTabPanel>
</MudTabs>}
</div>
@code{
 [Parameter]public Guid? Id{get;set;}private ManagedSiteEditModel _model=new();private ManagedSiteDetails? _details;private int _activeTab;private bool _loading=true,_saving,_addingMailbox,_addingCost,_addingSupport;private string _mailAddress="",_mailOwner="",_mailNotes="",_costDescription="",_costCategory="Outro",_costSupplier="",_costNotes="",_supportType="Outro",_supportDescription="",_supportStatus="Aberto",_supportNotes="",_historyText="";private ManagedSiteMailboxType _mailType;private ManagedSiteResourceStatus _mailStatus=ManagedSiteResourceStatus.Active;private decimal _costValue,_supportHours,_supportValue;private ManagedSitePeriodicity _costPeriodicity=ManagedSitePeriodicity.Monthly;private DateOnly? _costRenewal;private bool _supportBillable;
 protected override async Task OnParametersSetAsync(){if(Id is{}id){_details=await Service.GetAsync(id);if(_details is null){Snackbar.Add("Site não encontrado.",Severity.Error);Navigation.NavigateTo("/platform-admin/sites");return;}_model=ManagedSiteEditModel.From(_details.Data);}_loading=false;}
 private async Task SaveAsync(){_saving=true;try{if(Id is{}id){await Service.UpdateAsync(id,_model.ToCommand());_details=await Service.GetAsync(id);Snackbar.Add("Cadastro atualizado.",Severity.Success);}else{var createdId=await Service.CreateAsync(_model.ToCommand());Snackbar.Add("Site cadastrado.",Severity.Success);Navigation.NavigateTo($"/platform-admin/sites/{createdId}");}}catch(Exception e){Snackbar.Add(e.Message,Severity.Error);}finally{_saving=false;}}
 private void AddMailbox()=>_addingMailbox=true;private void ConfirmMailbox(){if(string.IsNullOrWhiteSpace(_mailAddress))return;_model.Mailboxes.Add(new(_mailAddress,_mailOwner,_mailType,_mailStatus,_mailNotes));_mailAddress=_mailOwner=_mailNotes="";_addingMailbox=false;}private void AddCost()=>_addingCost=true;private void ConfirmCost(){if(string.IsNullOrWhiteSpace(_costDescription))return;_model.Costs.Add(new(_costDescription,_costCategory,_costSupplier,_costValue,_costPeriodicity,_costRenewal,_costNotes));_costDescription=_costSupplier=_costNotes="";_costValue=0;_costRenewal=null;_addingCost=false;}private void AddSupport()=>_addingSupport=true;private void ConfirmSupport(){if(string.IsNullOrWhiteSpace(_supportDescription))return;_model.SupportEntries.Add(new(DateTime.UtcNow,_supportType,_supportDescription,_supportHours,_supportBillable,_supportValue,_supportStatus,_supportNotes));_supportDescription=_supportNotes="";_supportHours=_supportValue=0;_addingSupport=false;}private async Task AddHistoryAsync(){if(Id is not{}id||string.IsNullOrWhiteSpace(_historyText))return;await Service.AddHistoryAsync(id,_historyText);_historyText="";_details=await Service.GetAsync(id);Snackbar.Add("Anotação registrada.",Severity.Success);}private static string Money(decimal v)=>v.ToString("C",new System.Globalization.CultureInfo("pt-BR"));
}
