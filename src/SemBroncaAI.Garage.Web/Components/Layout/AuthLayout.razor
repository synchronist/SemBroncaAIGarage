@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudSnackbarProvider />

<div class="auth-shell">
    @Body
</div>

@code {
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#F97316",
            Background = "#F7F8FA",
            Surface = "#FFFFFF",
            TextPrimary = "#111827",
            TextSecondary = "#6B7280"
        }
    };
}
