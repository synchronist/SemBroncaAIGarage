@inherits LayoutComponentBase

@using SemBroncaAI.Garage.Web.Services
@using SemBroncaAI.Garage.Application.Abstractions.Security
@inject GarageService GarageService
@inject IConfiguration Configuration

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />


<div class="sbg-layout">

    @if (_mobileMenuOpen)
    {
        <button class="sbg-drawer-backdrop" type="button" aria-label="Fechar menu" @onclick="CloseMobileMenu"></button>
    }

    <aside class="sbg-sidebar @(_mobileMenuOpen ? "is-open" : null)">

        <div class="sbg-brand">
            <div class="sbg-brand-icon">
                <MudIcon Icon="@Icons.Material.Filled.Build"
                         Size="Size.Small" />
            </div>

            <div class="sbg-brand-text">
                <strong>@_garageName</strong>
                <span>@_garageLocation</span>
            </div>
        </div>

        <nav class="sbg-menu" @onclick="CloseMobileMenu">

            <AuthorizeView Policy="@ApplicationPermissions.CreateServiceOrder">
            <NavLink href="/"
                     Match="NavLinkMatch.All"
                     class="sbg-menu-item">
                <MudIcon Icon="@Icons.Material.Filled.DirectionsCar"
                         Size="Size.Small" />
                <span>Receber veículo</span>
            </NavLink>
            </AuthorizeView>

            <AuthorizeView Policy="@ApplicationPermissions.ViewServiceOrders">
            <NavLink href="/service-orders"
                     Match="NavLinkMatch.Prefix"
                     class="sbg-menu-item">
                <MudIcon Icon="@Icons.Material.Filled.Assignment"
                         Size="Size.Small" />
                <span>Ordens de serviço</span>
            </NavLink>
            </AuthorizeView>

            <AuthorizeView Policy="@ApplicationPermissions.ViewEstimateValues">
            <NavLink href="/estimates"
                     Match="NavLinkMatch.Prefix"
                     class="sbg-menu-item">
                <MudIcon Icon="@Icons.Material.Filled.RequestQuote"
                         Size="Size.Small" />
                <span>Orçamentos</span>
            </NavLink>
            </AuthorizeView>

            <AuthorizeView Policy="@ApplicationPermissions.ViewCustomersVehicles">
            <NavLink href="/customers"
                     Match="NavLinkMatch.Prefix"
                     class="sbg-menu-item">
                <MudIcon Icon="@Icons.Material.Filled.PeopleOutline"
                         Size="Size.Small" />
                <span>Clientes</span>
            </NavLink>

            <NavLink href="/vehicles"
                     Match="NavLinkMatch.Prefix"
                     class="sbg-menu-item">
                <MudIcon Icon="@Icons.Material.Filled.DirectionsCarFilled"
                         Size="Size.Small" />
                <span>Veículos</span>
            </NavLink>
            </AuthorizeView>

            <AuthorizeView Policy="@ApplicationPermissions.ManageGarageSettings">
            <NavLink href="/settings"
                     Match="NavLinkMatch.Prefix"
                     class="sbg-menu-item">
                <MudIcon Icon="@Icons.Material.Filled.Settings"
                         Size="Size.Small" />
                <span>Configurações</span>
            </NavLink>
            </AuthorizeView>

            <AuthorizeView Policy="@ApplicationPermissions.ManageTeam">
            <NavLink href="/team" Match="NavLinkMatch.Prefix" class="sbg-menu-item">
                <MudIcon Icon="@Icons.Material.Filled.Group" Size="Size.Small" />
                <span>Equipe</span>
            </NavLink>
            </AuthorizeView>

        </nav>

        <div class="sbg-sidebar-footer">
            Tecnologia SBGarage
        </div>

    </aside>

    <div class="sbg-shell">

        <header class="sbg-topbar">

            <div class="sbg-mobile-brand">
                <button class="sbg-menu-button" type="button" aria-label="Abrir menu" aria-expanded="@_mobileMenuOpen" @onclick="ToggleMobileMenu">
                    <MudIcon Icon="@Icons.Material.Filled.Menu" />
                </button>
                <div><strong>@_garageName</strong><span>@_garageLocation</span></div>
            </div>

            <div class="sbg-topbar-actions">

                <button class="sbg-icon-button"
                        type="button"
                        aria-label="Notificações">
                    <MudIcon Icon="@Icons.Material.Filled.NotificationsNone"
                             Size="Size.Small" />
                </button>

                <AuthorizeView Context="auth">
                    <Authorized>
                        <div class="sbg-user-avatar">@GetInitials(auth.User.Identity?.Name)</div>
                        <div class="sbg-user-data">
                            <strong>@auth.User.Identity?.Name</strong>
                            <span>@GetRoleLabel(auth.User)</span>
                        </div>
                        <form method="post" action="/auth/logout" class="sbg-logout-form">
                            <AntiforgeryToken />
                            <button class="sbg-icon-button" type="submit" aria-label="Sair" title="Sair">
                                <MudIcon Icon="@Icons.Material.Filled.Logout" Size="Size.Small" />
                            </button>
                        </form>
                    </Authorized>
                </AuthorizeView>

            </div>

        </header>

        <main class="sbg-main">
            @Body
        </main>

    </div>

</div>

@code {
    private bool _mobileMenuOpen;
    private void ToggleMobileMenu() => _mobileMenuOpen = !_mobileMenuOpen;
    private void CloseMobileMenu() => _mobileMenuOpen = false;
    private string _garageName = "Oficina";
    private string _garageLocation = "SBGarage";

    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "US";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.Take(2).Select(part => char.ToUpperInvariant(part[0])));
    }

    private static string GetRoleLabel(System.Security.Claims.ClaimsPrincipal user)
    {
        if (user.IsInRole("Owner")) return "Proprietário";
        if (user.IsInRole("Receptionist")) return "Recepção";
        if (user.IsInRole("Mechanic")) return "Mecânico";
        if (user.IsInRole("PlatformAdmin")) return "Plataforma";
        return "Equipe";
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var garage = await GarageService.GetBrandingAsync();
            if (garage is null) return;
            _garageName = string.IsNullOrWhiteSpace(garage.Name) ? "Oficina" : garage.Name;
            _garageLocation = !string.IsNullOrWhiteSpace(garage.City) && !string.IsNullOrWhiteSpace(garage.State)
                ? $"{garage.City} — {garage.State}"
                : "SBGarage";
        }
        catch
        {
            // O layout deve continuar disponível mesmo sem a API.
        }
    }

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#F97316",
            Background = "#F7F8FA",
            Surface = "#FFFFFF",
            TextPrimary = "#111827",
            TextSecondary = "#6B7280"
        }
    };
}
