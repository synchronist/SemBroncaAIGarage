# Copie para .env e substitua todos os placeholders. Nunca versione o arquivo .env.
POSTGRES_DB=sbgarage
POSTGRES_USER=sbgarage
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Deve ser a URL HTTPS pública que será usada nos links enviados aos usuários.
APP_PUBLIC_BASE_URL=https://garage.example.com

EMAIL_PROVIDER=Smtp
EMAIL_SMTP_HOST=smtp.example.invalid
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=replace-with-smtp-user
EMAIL_SMTP_PASSWORD=replace-with-smtp-password
EMAIL_FROM_ADDRESS=no-reply@example.invalid
EMAIL_FROM_NAME=SemBroncaAI Garage
EMAIL_USE_SSL=true
EMAIL_TIMEOUT_SECONDS=15
PASSWORD_RECOVERY_ENABLED=true

# Stripe Billing. Use sk_test/whsec from a Sandbox locally; never commit real values.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=

# One-shot PlatformAdmin bootstrap. Keep values empty here; set only in the ignored local .env.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
